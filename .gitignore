# Node modules
node_modules/

# Build output
/dist/
.tanstack/

# La APP real servida en /app: se copia desde el repo `bitly`
# (`flutter build web`) con `pnpm preparar:app`. Es un bundle, no código: no se
# versiona (si no, cada deploy del sitio sumaría decenas de MB de assets).
/public/app/
.capturas-perfil/
.capturas-perfil-*/

# Bundles y capturas que generan los harness de `scripts/` en cada corrida
/scripts/.cache/

# Claves privadas de firma (Ed25519 de los códigos Premium). Nunca al repo.
/scripts/keys/

# Estado local de wrangler (miniflare: cache, kv, r2, d1)
/.wrangler/
/.wrangler-verif*/

# Capturas originales (se convierten a WebP en src/assets/capturas con
# `pnpm capturas:reales`; lo que se publica es el resultado)
/capturas-reales/*.png
/capturas-reales/*.PNG
/capturas-reales/*.jpg
/capturas-reales/*.JPG
/capturas-reales/*.jpeg
/capturas-reales/*.JPEG
/capturas-reales/*.webp
/capturas-reales/*.WEBP

# Environment files
.env

# OS generated files
.DS_Store
Thumbs.db

# Log files
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# IDE/editor folders
.vscode/
.idea/

# Estado local de wrangler pages dev
.dev.vars

# Informes de Lighthouse (`pnpm auditar` + npx lighthouse --output-path=lhN.json)
/lh*.json
