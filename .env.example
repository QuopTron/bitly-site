# Client-side (Vite build-time)
VITE_SUPABASE_URL=tu_supabase_url_aqui
VITE_SUPABASE_PUBLISHABLE_KEY=tu_supabase_anon_key_aqui

# Server-side (SSR / middleware)
SUPABASE_URL=tu_supabase_url_aqui
SUPABASE_PUBLISHABLE_KEY=tu_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Token de GitHub con acceso de LECTURA al repo privado QuopTron/bitly_codes_premium.
# Lo usa el canje de códigos Premium (src/lib/premium-check.ts) para leer codes.json,
# igual que hace la app. Sin esto el canje responde "no pudimos verificar".
# NUNCA prefijarlo con VITE_: el prefijo lo manda al bundle del navegador.
BITLY_CODES_TOKEN=ghp_tu_token_aqui
