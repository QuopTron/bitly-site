# Backend de yt-dlp de la demo (ver scripts/backend-yt-dlp.mjs).
#
# Pensado para el plan free de Render: escucha en 0.0.0.0:$PORT, no escribe en
# disco (el audio se streamea desde googlevideo) y contesta /salud, que es lo
# que usa el despertador del sitio (src/server/rescate.ts) para que el arranque
# en frío no se pague cuando el visitante ya tocó play.
#
# Build:  docker build -f Dockerfile.backend -t bitly-yt-dlp .
# Run:    docker run -p 8080:8080 -e YT_DLP_TOKEN=... bitly-yt-dlp

FROM node:22-alpine

# yt-dlp es un programa de Python; ffmpeg no hace falta para streamear la URL
# cruda, pero yt-dlp lo consulta para elegir formatos y sin él avisa en cada
# corrida. Queda instalado porque en Alpine pesa poco.
RUN apk add --no-cache python3 py3-pip ffmpeg \
  && pip install --no-cache-dir --break-system-packages -U yt-dlp

WORKDIR /app
COPY scripts/backend-yt-dlp.mjs ./backend-yt-dlp.mjs

# Render define PORT solo; el default deja correrlo a mano igual.
ENV HOST=0.0.0.0 \
    PORT=8080 \
    NODE_ENV=production

EXPOSE 8080

# `--host 0.0.0.0` es obligatorio: el de fábrica es 127.0.0.1 (herramienta de
# desarrollo) y desde el contenedor no se podría entrar.
CMD ["node", "backend-yt-dlp.mjs", "--host", "0.0.0.0"]
